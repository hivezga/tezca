[Desktop Entry]
Type=Application
Name=Tezca Settings
GenericName=Control Center
Comment=Manage themes, wallpaper, keybinds, gaming and the session
Exec=tezca-settings
Icon=preferences-desktop-theme
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=tezca;theme;wallpaper;keybinds;rice;control;center;
# The Tauri build reports its product name as the app id, where the GTK build
# reported the application-id. This is what associates the window with this
# entry, so it has to follow.
StartupWMClass=tezca-settings
