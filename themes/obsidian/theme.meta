# Tezca curated theme metadata. Simple `key = value` lines (parsed by `tezca`).
# `wallpaper` is resolved relative to the repo's wallpapers/ directory. `label` is
# the display name Settings shows on the theme card (the directory name, properly
# spelled and accented); it falls back to a capitalised `name` when absent.
name = obsidian
label = Obsidian
description = The signature smoking mirror — obsidian black, turquoise/jade accent
wallpaper = obsidian-teal.jpg
mode = dark
